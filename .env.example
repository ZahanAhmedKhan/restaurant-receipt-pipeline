# Copy this file to .env and fill in real values.
# Never commit .env.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=receipts
DB_TEST_NAME=receipts_test
DB_APP_USER=receipts_app
DB_APP_PASSWORD=change_me
DB_READONLY_USER=receipts_readonly
DB_READONLY_PASSWORD=change_me

# --- OCR ---
# Full path to tesseract.exe (leave empty if tesseract is on PATH)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# tesseract (default) or gemini
OCR_METHOD=tesseract

# --- Gemini (optional) ---
GEMINI_API_KEY=
# Any Gemini model that accepts images (free tier); change if Google renames it
GEMINI_MODEL=gemini-3.8-flash
# Must stay false unless you approve sending real receipts to Gemini
ALLOW_EXTERNAL_AI_ON_PRIVATE=false

# --- Streamlit app ---
# Hash of the app password (instructions added in M3.2)
APP_PASSWORD_HASH=

# --- Price alerts ---
# Flag a price rise above this percent
PRICE_ALERT_THRESHOLD_PCT=10
