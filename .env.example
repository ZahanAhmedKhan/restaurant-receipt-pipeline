# Copy this file to .env and fill in real values.
# Never commit .env.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=receipts
DB_TEST_NAME=receipts_test
DB_APP_USER=receipts_app
DB_APP_PASSWORD=change_me
DB_READONLY_USER=receipts_readonly
DB_READONLY_PASSWORD=change_me

# --- OCR ---
# Full path to tesseract.exe (leave empty if tesseract is on PATH)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# tesseract (default) or gemini
OCR_METHOD=tesseract

# --- Gemini (optional) ---
GEMINI_API_KEY=
# Any Gemini model that accepts images (free tier); change if Google renames it
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the first model is overloaded
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Must stay false unless you approve sending real receipts to Gemini
ALLOW_EXTERNAL_AI_ON_PRIVATE=false

# --- Streamlit app ---
# Hashes of the two app passwords. Set them with:
#   python scripts/set_app_password.py               (staff password)
#   python scripts/set_app_password.py --developer   (developer password)
APP_PASSWORD_HASH=
DEVELOPER_PASSWORD_HASH=

# --- Country ---
# Leave empty to accept receipts from every country (default).
# Set to CA, US or AU to accept only that country; receipts clearly from
# another country are then rejected automatically.
ALLOWED_COUNTRY=
# How dates like 06/07/2026 are read: MDY (June 7) or DMY (6 July)
DATE_ORDER=MDY

# --- Price alerts ---
# Flag a price rise above this percent
PRICE_ALERT_THRESHOLD_PCT=10
